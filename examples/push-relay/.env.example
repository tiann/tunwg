# Published tunwg commit containing static SNI support.
TUNWG_IMAGE=ghcr.io/tiann/tunwg:e047fa3
TUNWG_IP=43.130.231.139
TUNWG_API=relay.hapi.run
TUNWG_AUTH_SECRET=replace_with_your_existing_signing_secret
TUNWG_QUOTA_BYTES=5368709120
# Reuse the existing directory, including keys, certificates and access state.
TUNWG_DATA_DIR=/absolute/path/to/existing/relay/data

PUSH_DOMAIN=push.hapi.run
# Pin to sha-<full-commit-sha> or a digest from HAPI's Push Relay Image workflow.
PUSH_RELAY_IMAGE=ghcr.io/tiann/hapi-push-relay:latest
APNS_KEY_P8_PATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=YYYYYYYYYY
APNS_BUNDLE_ID=run.hapi.app
# TestFlight / App Store: production. Development-signed builds: sandbox.
APNS_ENV=production
